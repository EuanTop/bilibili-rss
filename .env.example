# Service listener. Keep localhost unless a trusted reverse proxy is used.
BILIBILI_RSS_HOST=127.0.0.1
BILIBILI_RSS_PORT=8765
# Docker Compose host binding (not read by the Python process).
BILIBILI_RSS_BIND=127.0.0.1

# Cookie is read only from this file. Use `bilibili-rss cookie set` to create it.
BILIBILI_COOKIE_FILE=./data/bilibili.cookie

# Requests, cache, and bounded audit logs.
BILIBILI_TIMEOUT_SECONDS=20
BILIBILI_CACHE_TTL_SECONDS=300
BILIBILI_MAX_ITEMS=10
BILIBILI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0.0.0 Safari/537.36
BILIBILI_RATE_LIMIT_DELAY_SECONDS=2
BILIBILI_MAX_CONCURRENCY=4
BILIBILI_UPSTREAM_MIN_INTERVAL_SECONDS=0.5
BILIBILI_DATA_DIR=./data
BILIBILI_AUDIT_MAX_BYTES=5242880
BILIBILI_AUDIT_BACKUP_COUNT=3
